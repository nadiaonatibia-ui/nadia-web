{
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "redirects": [
    { "source": "/", "destination": "/es/", "permanent": true },
    { "source": "/portfolio", "destination": "/es/portfolio", "permanent": true },
    { "source": "/blog", "destination": "/es/blog", "permanent": true },
    { "source": "/cv", "destination": "/es/cv", "permanent": true },
    { "source": "/contact", "destination": "/es/contact", "permanent": true },
    { "source": "/privacy", "destination": "/es/privacy", "permanent": true },
    { "source": "/legal", "destination": "/es/legal", "permanent": true },
    { "source": "/cookies", "destination": "/es/cookies", "permanent": true }
  ],
  "rewrites": [
    { "source": "/es", "destination": "/index.html" },
    { "source": "/es/:path*", "destination": "/index.html" },
    { "source": "/en", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/ca", "destination": "/index.html" },
    { "source": "/ca/:path*", "destination": "/index.html" }
  ]
}
