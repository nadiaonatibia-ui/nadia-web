{
  "version": 3,
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Location": "/es/"
      },
      "status": 308
    },
    {
      "src": "^/portfolio$",
      "headers": {
        "Location": "/es/portfolio"
      },
      "status": 308
    },
    {
      "src": "^/blog$",
      "headers": {
        "Location": "/es/blog"
      },
      "status": 308
    },
    {
      "src": "^/cv$",
      "headers": {
        "Location": "/es/cv"
      },
      "status": 308
    },
    {
      "src": "^/contact$",
      "headers": {
        "Location": "/es/contact"
      },
      "status": 308
    },
    {
      "src": "^/privacy$",
      "headers": {
        "Location": "/es/privacy"
      },
      "status": 308
    },
    {
      "src": "^/legal$",
      "headers": {
        "Location": "/es/legal"
      },
      "status": 308
    },
    {
      "src": "^/cookies$",
      "headers": {
        "Location": "/es/cookies"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/es$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/es(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "dest": "/index.html?path=$1",
      "check": true
    },
    {
      "src": "^/en$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/en(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "dest": "/index.html?path=$1",
      "check": true
    },
    {
      "src": "^/ca$",
      "dest": "/index.html",
      "check": true
    },
    {
      "src": "^/ca(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?$",
      "dest": "/index.html?path=$1",
      "check": true
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "^(?!/api).*$",
      "dest": "/404.html"
    }
  ],
  "framework": {
    "slug": "vite",
    "version": "5.4.21"
  },
  "crons": []
}
